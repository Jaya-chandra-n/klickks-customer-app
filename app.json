{
    "expo": {
        "name": "Klickks",
        "slug": "klickks-customer-app",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "klickkscustomerapp",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.klickksapp.klickkscustomerapp"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#FFFFFF",
                "foregroundImage": "./assets/images/icon.png"
            },
            "edgeToEdgeEnabled": true,
            "package": "com.klickksapp.klickkscustomerapp"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/icon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ]
        ],
        "experiments": {
            "typedRoutes": false,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "klickks-customer-app"
            }
        }
    }
}
